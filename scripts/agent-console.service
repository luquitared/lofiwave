[Unit]
Description=lofiwave (Claude / Codex process manager)
# Tailscale is a system service; user units can't order on it, but the console
# binds 0.0.0.0 so it's reachable over the tailnet as soon as tailscaled is up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-console
ExecStart=%h/agent-console/scripts/start.sh
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=default.target
